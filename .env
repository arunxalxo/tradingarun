# Forwarder
FORWARDER_PORT=4000
BRIDGE_URL=https://your-bridge-host/tv-webhook
WEBHOOK_SECRET=your_shared_secret_here

# Optional: base64 of "user:pass" if your bridge requires basic auth
BRIDGE_BASIC_AUTH=BASE64_USER_COLON_PASS

# Logging and retries
FORWARDER_LOG=true
FORWARDER_MAX_RETRIES=2
FORWARDER_RETRY_DELAY_MS=1000
